        )
      );
      allow update: if isValidId(versionId) && isVerifiedUser() && isValidSyllabusVersion(incoming()) &&
        incoming().syllabusId == existing().syllabusId &&
        incoming().versionNumber == existing().versionNumber &&
        incoming().createdAt == existing().createdAt && (
        hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ACADEMIC_MANAGER']) ||
        (
          isLecturer() &&
          existing().status in ['Draft', 'Pending Review'] &&
          incoming().status in ['Draft', 'Pending Review'] &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'changeSummary', 'totalCourseDuration', 'finalAssessment',
            'announcementNote', 'attachment', 'supportingResources', 'modules', 'updatedAt'
          ])
        )
      );
      allow delete: if false;
    }

    match /moduleProgress/{progressId} {
      allow get: if isValidId(progressId) && isVerifiedUser() && (
        resource.data.userId == request.auth.uid || isAdminStaff() || isLecturer()
      );
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(progressId) && isVerifiedUser() &&
        isValidModuleProgress(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isValidId(progressId) && isVerifiedUser() &&
        isValidModuleProgress(incoming()) &&
        incoming().userId == existing().userId &&
        existing().userId == request.auth.uid &&
        incoming().courseId == existing().courseId &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'syllabusId', 'versionNumber', 'completedModuleIds', 'completedTopicIds',
          'completedActivityIds', 'completedAssignmentIds', 'totalTrackableItems',
          'completedTrackableItems', 'progressPercent', 'updatedAt'
        ]);
      allow delete: if isValidId(progressId) && isSuperAdminOwner();
    }

    // MODULE 3: BRAND SETTINGS, AI POSTER AUTOMATION & MARKETING CAMPAIGNS
    match /brandSettings/{institutionId} {
      allow get: if isValidId(institutionId);
      allow list: if isSuperAdminOwner();
      allow create, update: if isValidId(institutionId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'CONTENT_MANAGER']) && isValidBrandSettings(incoming());
      allow delete: if false;
    }

    match /generatedPosters/{posterId} {
      allow get: if isValidId(posterId) && (
        resource.data.status == 'published' ||
        hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'CONTENT_MANAGER', 'BRANCH_MANAGER']) ||
        (isLecturer() && resource.data.createdByUid == request.auth.uid)
      );
      allow list: if resource.data.status == 'published' || isSuperAdminOwner() || (isVerifiedUser() && resource.data.createdByUid == request.auth.uid);
      // Creation NEVER allows direct approval or publishing — must start as draft or pending_approval
      allow create: if isValidId(posterId) &&
        (hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'CONTENT_MANAGER', 'BRANCH_MANAGER']) || isLecturer()) &&
        isValidGeneratedPoster(incoming()) &&
        incoming().createdByUid == request.auth.uid &&
        incoming().status in ['draft', 'pending_approval'] &&
        (!('approvedVersionNumber' in incoming()) || incoming().approvedVersionNumber == 0) &&
        (!('approvedByUid' in incoming()) || incoming().approvedByUid == '') &&
        (!('publishedByUid' in incoming()) || incoming().publishedByUid == '');
      // Updates enforce strict approval -> publishing state machine:
      // - Only Super Admin Owner can approve, reject, request changes, publish, or archive.
      // - Publishing REQUIRES existing().status in ['approved', 'published'], matching approvedVersionNumber & approvedContentHash, and validationPassed == true.
      // - Modifying contentHash of an approved/published poster MUST increment versionNumber, drop status to draft/pending_approval/needs_update, and clear approvedVersionNumber & approvedContentHash.
      // - Non-Super-Admin creators (Branch Admin, Marketing Staff, Lecturer) can only edit their own non-published drafts/changes_requested and submit for pending_approval.
      allow update: if isValidId(posterId) && isValidGeneratedPoster(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().createdByUid == existing().createdByUid && (
        (
          isSuperAdminOwner() && (
            // If poster was already approved/published and contentHash changes (not archiving), force new version & invalidate prior approval
            !(existing().status in ['approved', 'published']) ||
            incoming().status == 'archived' ||
            (
              'approvedContentHash' in existing() &&
              incoming().contentHash == existing().approvedContentHash
            ) ||
            (
              incoming().versionNumber > existing().versionNumber &&
              incoming().status in ['draft', 'pending_approval', 'needs_update'] &&
              (!('approvedVersionNumber' in incoming()) || incoming().approvedVersionNumber == 0) &&
              (!('approvedContentHash' in incoming()) || incoming().approvedContentHash == '')
            )
          ) && (
            incoming().status != 'published' || (
              existing().status in ['approved', 'published'] &&
              incoming().validationPassed == true &&
              'approvedVersionNumber' in existing() &&
              incoming().versionNumber == existing().approvedVersionNumber &&
              'approvedContentHash' in existing() &&
              incoming().contentHash == existing().approvedContentHash &&
              'publishedByUid' in incoming() &&
              incoming().publishedByUid == request.auth.uid
            )
          )
        ) || (
          (hasStaffRole(['ADMIN', 'CONTENT_MANAGER', 'BRANCH_MANAGER']) || isLecturer()) &&
          existing().createdByUid == request.auth.uid &&
          existing().status in ['draft', 'changes_requested', 'rejected', 'needs_update'] &&
          incoming().status in ['draft', 'pending_approval'] &&
          (!('approvedVersionNumber' in incoming()) || incoming().approvedVersionNumber == 0) &&
          (!('approvedByUid' in incoming()) || incoming().approvedByUid == '') &&
          (!('publishedByUid' in incoming()) || incoming().publishedByUid == '')
        )
      );
      allow delete: if isValidId(posterId) && isSuperAdminOwner() && existing().status != 'published';
    }

    match /posterVersions/{versionId} {
      allow get: if isValidId(versionId) && (
        hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'CONTENT_MANAGER', 'BRANCH_MANAGER']) ||
        (isLecturer() && resource.data.createdByUid == request.auth.uid)
      );
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.createdByUid == request.auth.uid);
      allow create: if isValidId(versionId) &&
        (hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'CONTENT_MANAGER', 'BRANCH_MANAGER']) || isLecturer()) &&
        isValidPosterVersion(incoming()) &&
        incoming().createdByUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /posterApprovalLogs/{logId} {
      allow get: if isValidId(logId) && (
        hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'CONTENT_MANAGER', 'BRANCH_MANAGER']) ||
        (isLecturer() && resource.data.performedByUid == request.auth.uid)
      );
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.performedByUid == request.auth.uid);
      allow create: if isValidId(logId) && isVerifiedUser() && isValidPosterApprovalLog(incoming()) &&
        incoming().performedByUid == request.auth.uid && (
          isSuperAdminOwner() ||
          ((hasStaffRole(['ADMIN', 'CONTENT_MANAGER', 'BRANCH_MANAGER']) || isLecturer()) && incoming().action in ['submitted_for_approval', 'approval_invalidated'])
        );
      allow update, delete: if false;
    }

    match /posterPublishingLogs/{logId} {
      allow get: if isValidId(logId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'CONTENT_MANAGER']);
      allow list: if isSuperAdminOwner();
      allow create: if isValidId(logId) && isSuperAdminOwner() && isValidPosterPublishingLog(incoming()) &&
        incoming().publishedByUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /marketingCampaigns/{campaignId} {
      allow get: if isValidId(campaignId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'CONTENT_MANAGER']);
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.createdByUid == request.auth.uid);
      allow create, update: if isValidId(campaignId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'CONTENT_MANAGER']) && isValidMarketingCampaign(incoming());
      allow delete: if isValidId(campaignId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN']);
    }

    // MODULE 4: CENTRALIZED AI INTEGRATIONS & AUTOMATION WORKFLOWS (Strictly Super Admin only)
    match /integrations/{providerId} {
      allow get: if isValidId(providerId) && isSuperAdminOwner();
      allow list: if isSuperAdminOwner();
      allow create, update: if isValidId(providerId) && isSuperAdminOwner() && isValidIntegrationConfig(incoming()) && incoming().provider == providerId;
      allow delete: if false;
    }

    match /integrationLogs/{logId} {
      allow get: if isValidId(logId) && isSuperAdminOwner();
      allow list: if isSuperAdminOwner();
      allow create: if isValidId(logId) && isSuperAdminOwner() && isValidIntegrationLog(incoming()) && incoming().actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /apifyRuns/{runId} {
      allow get: if isValidId(runId) && isSuperAdminOwner();
      allow list: if isSuperAdminOwner();
      allow create, update: if isValidId(runId) && isSuperAdminOwner() && isValidApifyRun(incoming());
      allow delete: if isValidId(runId) && isSuperAdminOwner();
    }

    match /automationWorkflows/{workflowId} {
      allow get: if isValidId(workflowId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'CONTENT_MANAGER']);
      allow list: if isSuperAdminOwner();
      allow create, update: if isValidId(workflowId) && isSuperAdminOwner() && isValidAutomationWorkflow(incoming()) && incoming().workflowKey == workflowId;
      allow delete: if false;
    }

    // MODULE 5: STUDENT ACCOUNT MANAGEMENT, EMAIL LOGS & SYLLABUS APPROVAL LOGS
    function isValidStudentAccount(data) {
      return data.keys().hasAll([
          'studentId', 'username', 'fullName', 'email', 'status',
          'mustChangePassword', 'createdByUid', 'createdByEmail',
          'institutionId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'studentId', 'username', 'fullName', 'email', 'phone',
          'courseId', 'courseName', 'batchName', 'branchId',
          'linkedUserUid', 'linkedMigratedId', 'status', 'mustChangePassword',
          'invitationSentAt', 'invitationCount', 'passwordUpdatedAt', 'lastLoginAt',
          'createdByUid', 'createdByEmail', 'institutionId', 'createdAt', 'updatedAt'
        ]) &&
        isNonEmptyStr(data.studentId, 40) &&
        isNonEmptyStr(data.username, 80) &&
        isNonEmptyStr(data.fullName, 140) &&
        isNonEmptyStr(data.email, 160) &&
        data.status in ['Not Created', 'Invitation Sent', 'Active', 'Suspended', 'Password Reset Required'] &&
        data.mustChangePassword is bool &&
        isValidId(data.createdByUid) &&
        isNonEmptyStr(data.createdByEmail, 160) &&
        isNonEmptyStr(data.institutionId, 64) &&
        isNonEmptyStr(data.createdAt, 40) &&
        isNonEmptyStr(data.updatedAt, 40) &&
        (!('phone' in data) || isStr(data.phone, 40)) &&
        (!('courseId' in data) || isStr(data.courseId, 128)) &&
        (!('courseName' in data) || isStr(data.courseName, 160)) &&
        (!('batchName' in data) || isStr(data.batchName, 120)) &&
        (!('branchId' in data) || isStr(data.branchId, 64)) &&
        (!('linkedUserUid' in data) || isStr(data.linkedUserUid, 128)) &&
        (!('linkedMigratedId' in data) || isStr(data.linkedMigratedId, 128)) &&
        (!('invitationSentAt' in data) || isStr(data.invitationSentAt, 40)) &&
        (!('invitationCount' in data) || isNonNegNum(data.invitationCount)) &&
        (!('passwordUpdatedAt' in data) || isStr(data.passwordUpdatedAt, 40)) &&
        (!('lastLoginAt' in data) || isStr(data.lastLoginAt, 40));
    }

    function isValidEmailLog(data) {
      return data.keys().hasAll([
          'emailType', 'recipientEmail', 'subject', 'bodyPreview', 'provider',
          'status', 'retryCount', 'sentByUid', 'sentByEmail', 'institutionId', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'emailType', 'recipientEmail', 'recipientName', 'studentId', 'courseId',
          'subject', 'bodyPreview', 'provider', 'status', 'errorMessage', 'retryCount',
          'sentByUid', 'sentByEmail', 'institutionId', 'sentAt', 'createdAt'
        ]) &&
        data.emailType in ['student_account_created', 'login_credentials', 'password_reset', 'admission_confirmation', 'syllabus_updated', 'academic_announcement'] &&
        isNonEmptyStr(data.recipientEmail, 160) &&
        isNonEmptyStr(data.subject, 240) &&
        isNonEmptyStr(data.bodyPreview, 1200) &&
        data.provider in ['resend', 'smtp', 'sandbox_outbox'] &&
        data.status in ['sent', 'failed', 'queued_configure_provider'] &&
        isNonNegNum(data.retryCount) &&
        isValidId(data.sentByUid) &&
        isNonEmptyStr(data.sentByEmail, 160) &&
        isNonEmptyStr(data.institutionId, 64) &&
        isNonEmptyStr(data.createdAt, 40) &&
        (!('recipientName' in data) || isStr(data.recipientName, 140)) &&
        (!('studentId' in data) || isStr(data.studentId, 40)) &&
        (!('courseId' in data) || isStr(data.courseId, 128)) &&
        (!('errorMessage' in data) || isStr(data.errorMessage, 500)) &&
        (!('sentAt' in data) || isStr(data.sentAt, 40));
    }

    function isValidSyllabusApprovalLog(data) {
      return data.keys().hasAll([
          'syllabusId', 'courseId', 'courseName', 'previousVersionNumber', 'versionNumber',
          'action', 'changeDescription', 'performedByUid', 'performedByName', 'performedByEmail',
          'institutionId', 'timestamp'
        ]) &&
        data.keys().hasOnly([
          'syllabusId', 'courseId', 'courseName', 'previousVersionNumber', 'versionNumber',
          'action', 'changeDescription', 'performedByUid', 'performedByName', 'performedByEmail',
          'institutionId', 'timestamp'
        ]) &&
        isNonEmptyStr(data.syllabusId, 128) &&
        isNonEmptyStr(data.courseId, 128) &&
        isNonEmptyStr(data.courseName, 160) &&
        isNonNegNum(data.previousVersionNumber) &&
        isNonNegNum(data.versionNumber) &&
        data.action in ['submitted_for_approval', 'approved', 'published', 'archived', 'restored', 'rejected'] &&
        isNonEmptyStr(data.changeDescription, 600) &&
        isValidId(data.performedByUid) &&
        isNonEmptyStr(data.performedByName, 120) &&
        isNonEmptyStr(data.performedByEmail, 160) &&
        isNonEmptyStr(data.institutionId, 64) &&
        isNonEmptyStr(data.timestamp, 40);
    }

    match /studentAccounts/{accountId} {
      allow get: if isValidId(accountId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN']);
      allow list: if isSuperAdminOwner() || hasStaffRole(['SUPER_ADMIN', 'ADMIN']);
      allow create: if isValidId(accountId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN']) &&
        isValidStudentAccount(incoming()) && incoming().createdByUid == request.auth.uid;
      allow update: if isValidId(accountId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN']) &&
        isValidStudentAccount(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().createdByUid == existing().createdByUid;
      allow delete: if isValidId(accountId) && isSuperAdminOwner();
    }

    match /emailLogs/{logId} {
      allow get: if isValidId(logId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ACADEMIC_MANAGER', 'ADMISSION_OFFICER']);
      allow list: if isSuperAdminOwner() || hasStaffRole(['SUPER_ADMIN', 'ADMIN']);
      allow create: if isValidId(logId) &&
        hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ACADEMIC_MANAGER', 'ADMISSION_OFFICER']) &&
        isValidEmailLog(incoming()) && incoming().sentByUid == request.auth.uid;
      allow update: if isValidId(logId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN']) &&
        isValidEmailLog(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().sentByUid == existing().sentByUid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'provider', 'errorMessage', 'retryCount', 'sentAt']);
      allow delete: if false;
    }

    match /syllabusApprovalLogs/{logId} {
      allow get: if isValidId(logId) && (
        hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ACADEMIC_MANAGER']) ||
        (isLecturer() && resource.data.performedByUid == request.auth.uid)
      );
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.performedByUid == request.auth.uid);
      allow create: if isValidId(logId) &&
        (hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ACADEMIC_MANAGER']) || isLecturer()) &&
        isValidSyllabusApprovalLog(incoming()) &&
        incoming().performedByUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
