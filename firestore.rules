        (!('announcementNote' in data) || isStr(data.announcementNote, 600)) &&
        (!('attachment' in data) || data.attachment == null || data.attachment is map) &&
        (!('supportingResources' in data) || (data.supportingResources is list && data.supportingResources.size() <= 20)) &&
        (!('restoredFromVersion' in data) || isNonNegNum(data.restoredFromVersion)) &&
        (!('createdByRole' in data) || isStr(data.createdByRole, 40)) &&
        (!('approvedByUid' in data) || isStr(data.approvedByUid, 128)) &&
        (!('approvedByName' in data) || isStr(data.approvedByName, 120)) &&
        (!('publishedAt' in data) || isStr(data.publishedAt, 40)) &&
        (!('updatedAt' in data) || isStr(data.updatedAt, 40));
    }

    function isValidModuleProgress(data) {
      return data.keys().hasAll([
          'userId', 'courseId', 'syllabusId', 'completedModuleIds', 'completedTopicIds',
          'completedActivityIds', 'completedAssignmentIds', 'totalTrackableItems',
          'completedTrackableItems', 'progressPercent', 'institutionId', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'courseId', 'syllabusId', 'versionNumber', 'completedModuleIds',
          'completedTopicIds', 'completedActivityIds', 'completedAssignmentIds',
          'totalTrackableItems', 'completedTrackableItems', 'progressPercent',
          'institutionId', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        isValidId(data.courseId) &&
        isNonEmptyStr(data.syllabusId, 64) &&
        data.completedModuleIds is list && data.completedModuleIds.size() <= 100 &&
        (data.completedModuleIds.size() == 0 || data.completedModuleIds[0] is string) &&
        data.completedTopicIds is list && data.completedTopicIds.size() <= 500 &&
        (data.completedTopicIds.size() == 0 || data.completedTopicIds[0] is string) &&
        data.completedActivityIds is list && data.completedActivityIds.size() <= 300 &&
        (data.completedActivityIds.size() == 0 || data.completedActivityIds[0] is string) &&
        data.completedAssignmentIds is list && data.completedAssignmentIds.size() <= 300 &&
        (data.completedAssignmentIds.size() == 0 || data.completedAssignmentIds[0] is string) &&
        isNonNegNum(data.totalTrackableItems) &&
        isNonNegNum(data.completedTrackableItems) &&
        isNonNegNum(data.progressPercent) && data.progressPercent <= 100 &&
        isNonEmptyStr(data.institutionId, 64) &&
        isNonEmptyStr(data.updatedAt, 40) &&
        (!('versionNumber' in data) || isNonNegNum(data.versionNumber));
    }

    function isValidBrandSettings(data) {
      return data.keys().hasAll(['institutionId', 'brandName', 'shortName', 'primaryColor', 'accentColor', 'logoUrl', 'contactPhone', 'website']) &&
        data.keys().hasOnly([
          'institutionId', 'brandName', 'shortName', 'tagline', 'primaryColor', 'secondaryColor',
          'accentColor', 'lightSurfaceColor', 'logoUrl', 'altLogoUrl', 'founderPhotoUrl',
          'contactPhone', 'whatsappNumber', 'website', 'email', 'defaultFooterNote',
          'updatedByUid', 'updatedAt'
        ]) &&
        isNonEmptyStr(data.institutionId, 64) &&
        isNonEmptyStr(data.brandName, 140) &&
        isNonEmptyStr(data.shortName, 64) &&
        isNonEmptyStr(data.primaryColor, 24) &&
        isNonEmptyStr(data.accentColor, 24) &&
        isNonEmptyStr(data.logoUrl, 500) &&
        isNonEmptyStr(data.contactPhone, 40) &&
        isNonEmptyStr(data.website, 160) &&
        (!('tagline' in data) || isStr(data.tagline, 200)) &&
        (!('secondaryColor' in data) || isStr(data.secondaryColor, 24)) &&
        (!('lightSurfaceColor' in data) || isStr(data.lightSurfaceColor, 24)) &&
        (!('altLogoUrl' in data) || isStr(data.altLogoUrl, 500)) &&
        (!('founderPhotoUrl' in data) || isStr(data.founderPhotoUrl, 500)) &&
        (!('whatsappNumber' in data) || isStr(data.whatsappNumber, 40)) &&
        (!('email' in data) || isStr(data.email, 160)) &&
        (!('defaultFooterNote' in data) || isStr(data.defaultFooterNote, 240)) &&
        (!('updatedByUid' in data) || isStr(data.updatedByUid, 128)) &&
        (!('updatedAt' in data) || isStr(data.updatedAt, 40));
    }

    function isValidGeneratedPoster(data) {
      return data.keys().hasAll([
          'title', 'posterType', 'templateStyle', 'sizePreset', 'language', 'headline',
          'highlights', 'ctaText', 'logoPosition', 'status', 'versionNumber',
          'createdByUid', 'createdByName', 'institutionId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'courseId', 'courseName', 'courseCode', 'courseCategory', 'isFreeCourse',
          'title', 'posterType', 'templateStyle', 'sizePreset', 'language', 'headline',
          'subheadline', 'badgeText', 'highlights', 'feeLabel', 'registrationFeeLabel', 'durationLabel', 'modeLabel',
          'ctaText', 'footerContact', 'backgroundImageUrl', 'customLogoUrl', 'logoPosition', 'accentColor',
          'fontScale', 'fontFamily', 'textAlign', 'headlineOffsetY', 'bgOpacity',
          'socialCaption', 'hashtags', 'whatsappMessage', 'status',
          'versionNumber', 'contentHash', 'approvedVersionNumber', 'approvedContentHash',
          'validationPassed', 'validationSummary', 'rejectionReason', 'changeInstructions',
          'courseSnapshotHash', 'courseSnapshotUpdatedAt', 'campaignId', 'generatedByProvider',
          'publishDestinations', 'scheduledPublishAt',
          'createdByUid', 'createdByName', 'createdByRole',
          'approvedByUid', 'approvedByName', 'approvedAt',
          'publishedByUid', 'publishedByName', 'publishedAt',
          'institutionId', 'createdAt', 'updatedAt'
        ]) &&
        isNonEmptyStr(data.title, 180) &&
        isNonEmptyStr(data.posterType, 80) &&
        data.templateStyle in ['navy_executive', 'electric_tech', 'free_spotlight', 'editorial_minimal'] &&
        data.sizePreset in ['instagram_square', 'instagram_portrait', 'instagram_story', 'facebook_landscape', 'a4_print', 'website_banner', 'whatsapp_promo'] &&
        data.language in ['English', 'Tamil', 'Sinhala', 'Arabic'] &&
        isNonEmptyStr(data.headline, 200) &&
        data.highlights is list && data.highlights.size() <= 10 &&
        (data.highlights.size() == 0 || data.highlights[0] is string) &&
        isNonEmptyStr(data.ctaText, 120) &&
        data.logoPosition in ['top-left', 'top-right', 'top-center'] &&
        data.status in ['draft', 'pending_approval', 'changes_requested', 'approved', 'rejected', 'published', 'needs_update', 'archived'] &&
        isNonNegNum(data.versionNumber) &&
        isValidId(data.createdByUid) &&
        isNonEmptyStr(data.createdByName, 120) &&
        isNonEmptyStr(data.institutionId, 64) &&
        isNonEmptyStr(data.createdAt, 40) &&
        isNonEmptyStr(data.updatedAt, 40) &&
        (!('courseId' in data) || isStr(data.courseId, 128)) &&
        (!('courseName' in data) || isStr(data.courseName, 160)) &&
        (!('courseCode' in data) || isStr(data.courseCode, 40)) &&
        (!('courseCategory' in data) || data.courseCategory in ['Certificate', 'Diploma', 'General']) &&
        (!('isFreeCourse' in data) || data.isFreeCourse is bool) &&
        (!('subheadline' in data) || isStr(data.subheadline, 320)) &&
        (!('badgeText' in data) || isStr(data.badgeText, 80)) &&
        (!('feeLabel' in data) || isStr(data.feeLabel, 120)) &&
        (!('registrationFeeLabel' in data) || isStr(data.registrationFeeLabel, 120)) &&
        (!('durationLabel' in data) || isStr(data.durationLabel, 80)) &&
        (!('modeLabel' in data) || isStr(data.modeLabel, 80)) &&
        (!('footerContact' in data) || isStr(data.footerContact, 200)) &&
        (!('backgroundImageUrl' in data) || isStr(data.backgroundImageUrl, 400000)) &&
        (!('customLogoUrl' in data) || isStr(data.customLogoUrl, 250000)) &&
        (!('accentColor' in data) || isStr(data.accentColor, 24)) &&
        (!('fontScale' in data) || isNonNegNum(data.fontScale)) &&
        (!('fontFamily' in data) || data.fontFamily in ['inter', 'geometric', 'serif', 'mono']) &&
        (!('textAlign' in data) || data.textAlign in ['left', 'center']) &&
        (!('headlineOffsetY' in data) || ((data.headlineOffsetY is int || data.headlineOffsetY is float) && data.headlineOffsetY >= -100 && data.headlineOffsetY <= 100)) &&
        (!('bgOpacity' in data) || ((data.bgOpacity is int || data.bgOpacity is float) && data.bgOpacity >= 0 && data.bgOpacity <= 1)) &&
        (!('socialCaption' in data) || isStr(data.socialCaption, 2500)) &&
        (!('hashtags' in data) || (data.hashtags is list && data.hashtags.size() <= 25 && (data.hashtags.size() == 0 || data.hashtags[0] is string))) &&
        (!('whatsappMessage' in data) || isStr(data.whatsappMessage, 1500)) &&
        (!('contentHash' in data) || isStr(data.contentHash, 128)) &&
        (!('approvedVersionNumber' in data) || isNonNegNum(data.approvedVersionNumber)) &&
        (!('approvedContentHash' in data) || isStr(data.approvedContentHash, 128)) &&
        (!('validationPassed' in data) || data.validationPassed is bool) &&
        (!('validationSummary' in data) || isStr(data.validationSummary, 500)) &&
        (!('rejectionReason' in data) || isStr(data.rejectionReason, 600)) &&
        (!('changeInstructions' in data) || isStr(data.changeInstructions, 800)) &&
        (!('courseSnapshotHash' in data) || isStr(data.courseSnapshotHash, 128)) &&
        (!('courseSnapshotUpdatedAt' in data) || isStr(data.courseSnapshotUpdatedAt, 40)) &&
        (!('campaignId' in data) || isStr(data.campaignId, 128)) &&
        (!('generatedByProvider' in data) || isStr(data.generatedByProvider, 64)) &&
        (!('publishDestinations' in data) || (data.publishDestinations is list && data.publishDestinations.size() <= 10 && (data.publishDestinations.size() == 0 || data.publishDestinations[0] is string))) &&
        (!('scheduledPublishAt' in data) || isStr(data.scheduledPublishAt, 40)) &&
        (!('createdByRole' in data) || isStr(data.createdByRole, 40)) &&
        (!('approvedByUid' in data) || isStr(data.approvedByUid, 128)) &&
        (!('approvedByName' in data) || isStr(data.approvedByName, 120)) &&
        (!('approvedAt' in data) || isStr(data.approvedAt, 40)) &&
        (!('publishedByUid' in data) || isStr(data.publishedByUid, 128)) &&
        (!('publishedByName' in data) || isStr(data.publishedByName, 120)) &&
        (!('publishedAt' in data) || isStr(data.publishedAt, 40));
    }

    function isValidPosterVersion(data) {
      return data.keys().hasAll([
          'posterId', 'versionNumber', 'headline', 'templateStyle', 'sizePreset',
          'language', 'highlights', 'ctaText', 'createdByUid', 'createdByName', 'institutionId', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'posterId', 'versionNumber', 'headline', 'subheadline', 'templateStyle', 'sizePreset',
          'language', 'highlights', 'ctaText', 'socialCaption', 'contentHash',
          'validationPassed', 'validationSummary', 'editableDesignDataJson', 'changeNote',
          'createdByUid', 'createdByName', 'institutionId', 'createdAt'
        ]) &&
        isValidId(data.posterId) &&
        isNonNegNum(data.versionNumber) &&
        isNonEmptyStr(data.headline, 200) &&
        isNonEmptyStr(data.templateStyle, 40) &&
        isNonEmptyStr(data.sizePreset, 40) &&
        isNonEmptyStr(data.language, 24) &&
        data.highlights is list && data.highlights.size() <= 10 &&
        (data.highlights.size() == 0 || data.highlights[0] is string) &&
        isNonEmptyStr(data.ctaText, 120) &&
        isValidId(data.createdByUid) &&
        isNonEmptyStr(data.createdByName, 120) &&
        isNonEmptyStr(data.institutionId, 64) &&
        isNonEmptyStr(data.createdAt, 40) &&
        (!('subheadline' in data) || isStr(data.subheadline, 320)) &&
        (!('socialCaption' in data) || isStr(data.socialCaption, 2500)) &&
        (!('contentHash' in data) || isStr(data.contentHash, 128)) &&
        (!('validationPassed' in data) || data.validationPassed is bool) &&
        (!('validationSummary' in data) || isStr(data.validationSummary, 500)) &&
        (!('editableDesignDataJson' in data) || isStr(data.editableDesignDataJson, 12000)) &&
        (!('changeNote' in data) || isStr(data.changeNote, 400));
    }

    function isValidPosterApprovalLog(data) {
      return data.keys().hasAll([
          'posterId', 'versionNumber', 'action', 'performedByUid', 'performedByName',
          'performedByEmail', 'institutionId', 'timestamp'
        ]) &&
        data.keys().hasOnly([
          'posterId', 'posterTitle', 'courseName', 'versionNumber', 'action', 'reason',
          'performedByUid', 'performedByName', 'performedByEmail', 'institutionId', 'timestamp'
        ]) &&
        isValidId(data.posterId) &&
        isNonNegNum(data.versionNumber) &&
        data.action in ['submitted_for_approval', 'approved', 'rejected', 'changes_requested', 'approval_invalidated', 'archived'] &&
        isValidId(data.performedByUid) &&
        isNonEmptyStr(data.performedByName, 120) &&
        isNonEmptyStr(data.performedByEmail, 160) &&
        isNonEmptyStr(data.institutionId, 64) &&
        isNonEmptyStr(data.timestamp, 40) &&
        (!('posterTitle' in data) || isStr(data.posterTitle, 180)) &&
        (!('courseName' in data) || isStr(data.courseName, 160)) &&
        (!('reason' in data) || isStr(data.reason, 800));
    }

    function isValidPosterPublishingLog(data) {
      return data.keys().hasAll([
          'posterId', 'versionNumber', 'destination', 'publishedByUid', 'publishedByName',
          'publishedByEmail', 'institutionId', 'timestamp'
        ]) &&
        data.keys().hasOnly([
          'posterId', 'posterTitle', 'courseId', 'versionNumber', 'destination', 'scheduledFor',
          'publishedByUid', 'publishedByName', 'publishedByEmail', 'institutionId', 'timestamp'
        ]) &&
        isValidId(data.posterId) &&
        isNonNegNum(data.versionNumber) &&
        data.destination in ['website_marketing_library', 'public_course_page', 'download_png', 'download_jpg', 'download_pdf', 'export_whatsapp', 'export_social_media', 'scheduled_campaign'] &&
        isValidId(data.publishedByUid) &&
        isNonEmptyStr(data.publishedByName, 120) &&
        isNonEmptyStr(data.publishedByEmail, 160) &&
        isNonEmptyStr(data.institutionId, 64) &&
        isNonEmptyStr(data.timestamp, 40) &&
        (!('posterTitle' in data) || isStr(data.posterTitle, 180)) &&
        (!('courseId' in data) || isStr(data.courseId, 128)) &&
        (!('scheduledFor' in data) || isStr(data.scheduledFor, 40));
    }

    function isValidMarketingCampaign(data) {
      return data.keys().hasAll([
          'name', 'campaignType', 'courseIds', 'posterIds', 'language', 'status',
          'createdByUid', 'createdByName', 'institutionId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name', 'campaignType', 'courseIds', 'posterIds', 'language', 'status',
          'summary', 'createdByUid', 'createdByName', 'institutionId', 'createdAt', 'updatedAt'
        ]) &&
        isNonEmptyStr(data.name, 160) &&
        data.campaignType in ['free_courses', 'certificate_intake', 'diploma_intake', 'custom_bulk'] &&
        data.courseIds is list && data.courseIds.size() <= 100 &&
        (data.courseIds.size() == 0 || data.courseIds[0] is string) &&
        data.posterIds is list && data.posterIds.size() <= 100 &&
        (data.posterIds.size() == 0 || data.posterIds[0] is string) &&
        data.language in ['English', 'Tamil', 'Sinhala', 'Arabic'] &&
        data.status in ['draft', 'pending_approval', 'approved', 'published', 'archived'] &&
        isValidId(data.createdByUid) &&
        isNonEmptyStr(data.createdByName, 120) &&
        isNonEmptyStr(data.institutionId, 64) &&
        isNonEmptyStr(data.createdAt, 40) &&
        isNonEmptyStr(data.updatedAt, 40) &&
        (!('summary' in data) || isStr(data.summary, 800));
    }

    function isValidIntegrationConfig(data) {
      return data.keys().hasAll(['provider', 'label', 'category', 'enabled', 'connectionStatus', 'institutionId']) &&
        data.keys().hasOnly([
          'provider', 'label', 'category', 'enabled', 'defaultModel', 'temperature',
          'maxTokens', 'monthlyBudgetUsd', 'allowedFeatures', 'defaultActorId',
          'connectionStatus', 'lastTestedAt', 'lastError', 'notes', 'updatedByUid',
          'institutionId', 'updatedAt'
        ]) &&
        data.provider in ['openai', 'apify', 'gemini_ai', 'google_sheets', 'firebase', 'email_provider', 'whatsapp_business', 'analytics'] &&
        isNonEmptyStr(data.label, 120) &&
        isNonEmptyStr(data.category, 64) &&
        data.enabled is bool &&
        data.connectionStatus in ['not_configured', 'connected', 'error', 'testing'] &&
        isNonEmptyStr(data.institutionId, 64) &&
        (!('defaultModel' in data) || isStr(data.defaultModel, 80)) &&
        (!('temperature' in data) || isNonNegNum(data.temperature)) &&
        (!('maxTokens' in data) || isNonNegNum(data.maxTokens)) &&
        (!('monthlyBudgetUsd' in data) || isNonNegNum(data.monthlyBudgetUsd)) &&
        (!('allowedFeatures' in data) || (data.allowedFeatures is list && data.allowedFeatures.size() <= 20 && (data.allowedFeatures.size() == 0 || data.allowedFeatures[0] is string))) &&
        (!('defaultActorId' in data) || isStr(data.defaultActorId, 120)) &&
        (!('lastTestedAt' in data) || isStr(data.lastTestedAt, 40)) &&
        (!('lastError' in data) || isStr(data.lastError, 400)) &&
        (!('notes' in data) || isStr(data.notes, 600)) &&
        (!('updatedByUid' in data) || isStr(data.updatedByUid, 128)) &&
        (!('updatedAt' in data) || isStr(data.updatedAt, 40));
    }

    function isValidIntegrationLog(data) {
      return data.keys().hasAll(['provider', 'action', 'status', 'summary', 'actorUid', 'actorEmail', 'institutionId', 'createdAt']) &&
        data.keys().hasOnly([
          'provider', 'action', 'status', 'modelOrActor', 'durationMs',
          'summary', 'actorUid', 'actorEmail', 'institutionId', 'createdAt'
        ]) &&
        isNonEmptyStr(data.provider, 40) &&
        isNonEmptyStr(data.action, 80) &&
        data.status in ['success', 'error', 'not_configured'] &&
        isNonEmptyStr(data.summary, 500) &&
        isValidId(data.actorUid) &&
        isNonEmptyStr(data.actorEmail, 160) &&
        isNonEmptyStr(data.institutionId, 64) &&
        isNonEmptyStr(data.createdAt, 40) &&
        (!('modelOrActor' in data) || isStr(data.modelOrActor, 120)) &&
        (!('durationMs' in data) || isNonNegNum(data.durationMs));
    }

    function isValidApifyRun(data) {
      return data.keys().hasAll(['actorId', 'runId', 'purpose', 'status', 'startedByUid', 'startedByEmail', 'institutionId', 'createdAt']) &&
        data.keys().hasOnly([
          'actorId', 'runId', 'datasetId', 'purpose', 'status', 'itemCount',
          'previewJson', 'reviewedByUid', 'startedByUid', 'startedByEmail',
          'institutionId', 'createdAt', 'updatedAt'
        ]) &&
        isNonEmptyStr(data.actorId, 120) &&
        isNonEmptyStr(data.runId, 120) &&
        isNonEmptyStr(data.purpose, 200) &&
        data.status in ['RUNNING', 'SUCCEEDED', 'FAILED', 'ABORTED', 'QUEUED'] &&
        isValidId(data.startedByUid) &&
        isNonEmptyStr(data.startedByEmail, 160) &&
        isNonEmptyStr(data.institutionId, 64) &&
        isNonEmptyStr(data.createdAt, 40) &&
        (!('datasetId' in data) || isStr(data.datasetId, 120)) &&
        (!('itemCount' in data) || isNonNegNum(data.itemCount)) &&
        (!('previewJson' in data) || isStr(data.previewJson, 12000)) &&
        (!('reviewedByUid' in data) || isStr(data.reviewedByUid, 128)) &&
        (!('updatedAt' in data) || isStr(data.updatedAt, 40));
    }

    function isValidAutomationWorkflow(data) {
      return data.keys().hasAll([
          'workflowKey', 'name', 'description', 'enabled', 'requiresAdminApproval',
          'defaultLanguage', 'defaultSizePreset', 'institutionId'
        ]) &&
        data.keys().hasOnly([
          'workflowKey', 'name', 'description', 'enabled', 'requiresAdminApproval',
          'defaultLanguage', 'defaultSizePreset', 'lastTriggeredAt', 'lastRunSummary',
          'institutionId', 'updatedAt'
        ]) &&
        data.workflowKey in ['new_course_poster', 'course_update_detector', 'free_course_campaign', 'bulk_campaign_package'] &&
        isNonEmptyStr(data.name, 120) &&
        isNonEmptyStr(data.description, 500) &&
        data.enabled is bool &&
        data.requiresAdminApproval is bool &&
        data.defaultLanguage in ['English', 'Tamil', 'Sinhala', 'Arabic'] &&
        isNonEmptyStr(data.defaultSizePreset, 40) &&
        isNonEmptyStr(data.institutionId, 64) &&
        (!('lastTriggeredAt' in data) || isStr(data.lastTriggeredAt, 40)) &&
        (!('lastRunSummary' in data) || isStr(data.lastRunSummary, 400)) &&
        (!('updatedAt' in data) || isStr(data.updatedAt, 40));
    }

    // 4. COLLECTION RULES

    match /test/connection {
      allow get: if true;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && (request.auth.uid == userId || isAdminStaff());
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.uid == request.auth.uid);

      allow create: if isValidId(userId) && isVerifiedUser() && isValidUserProfile(incoming()) && (
        isSuperAdminOwner() ||
        (
          request.auth.uid == userId &&
          incoming().uid == userId &&
          incoming().role == 'STUDENT' &&
          incoming().accountStatus == 'active'
        )
      );

      allow update: if isValidId(userId) && isVerifiedUser() && isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid && (
        isSuperAdminOwner() ||
        (
          isAdminStaff() &&
          existing().role != 'SUPER_ADMIN' &&
          incoming().role != 'SUPER_ADMIN'
        ) ||
        (
          request.auth.uid == userId &&
          incoming().role == existing().role &&
          incoming().accountStatus == existing().accountStatus &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'xpPoints', 'streakDays', 'level', 'updatedAt'])
        )
      );

      allow delete: if isValidId(userId) && isSuperAdminOwner() && existing().role != 'SUPER_ADMIN';

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && isVerifiedUser() && (request.auth.uid == userId || isAdminStaff());
        allow list: if isSuperAdminOwner() || (isVerifiedUser() && request.auth.uid == userId);
        allow create, update: if isValidId(userId) && isValidId(docId) && isVerifiedUser() &&
          isValidUserPii(incoming()) && incoming().uid == userId && (
