rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. GLOBAL SAFETY NET (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. CORE SECURITY PRIMITIVES
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Protected Dual-Owner / CEO Super Admin accounts (0 DB reads, safe for list queries)
    function isSuperAdminOwner() {
      return isVerifiedUser() && (
        request.auth.token.email == 'techmanfgoc@gmail.com' ||
        request.auth.token.email == 'mrashadh64@gmail.com'
      );
    }

    function isAdminStaff() {
      return isSuperAdminOwner() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function getAdminRole() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role;
    }

    function hasStaffRole(allowedRoles) {
      return isSuperAdminOwner() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        getAdminRole() in allowedRoles
      );
    }

    function isLecturer() {
      return isSuperAdminOwner() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['SUPER_ADMIN', 'ADMIN', 'ACADEMIC_MANAGER', 'LECTURER', 'EXAMINER']
      );
    }

    function isStr(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isNonEmptyStr(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function isNonNegNum(val) {
      return (val is int || val is float) && val >= 0;
    }

    // 3. VALIDATION BLUEPRINTS
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'institutionId', 'accountStatus']) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'role', 'designation', 'studentId',
          'lecturerId', 'branchId', 'institutionId', 'accountStatus',
          'xpPoints', 'streakDays', 'level', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        isNonEmptyStr(data.displayName, 120) &&
        data.role in [
          'SUPER_ADMIN', 'ADMIN', 'BRANCH_MANAGER', 'COORDINATOR', 'ADMISSION_OFFICER',
          'ACADEMIC_MANAGER', 'LECTURER', 'ACCOUNTANT', 'EXAMINER', 'CONTENT_MANAGER',
          'STUDENT', 'AFFILIATE', 'SUPPORT_STAFF'
        ] &&
        isNonEmptyStr(data.institutionId, 64) &&
        data.accountStatus in ['active', 'suspended', 'pending'] &&
        (!('photoURL' in data) || isStr(data.photoURL, 500)) &&
        (!('designation' in data) || isStr(data.designation, 80)) &&
        (!('studentId' in data) || isStr(data.studentId, 40)) &&
        (!('lecturerId' in data) || isStr(data.lecturerId, 40)) &&
        (!('branchId' in data) || isStr(data.branchId, 64)) &&
        (!('xpPoints' in data) || isNonNegNum(data.xpPoints)) &&
        (!('streakDays' in data) || isNonNegNum(data.streakDays)) &&
        (!('level' in data) || isNonNegNum(data.level));
    }

    function isValidUserPii(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.keys().hasOnly([
          'uid', 'email', 'phone', 'whatsapp', 'dateOfBirth', 'gender',
          'address', 'emergencyContact', 'guardianName', 'guardianPhone',
          'qualifications', 'specialization', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        isNonEmptyStr(data.email, 160) &&
        (!('phone' in data) || isStr(data.phone, 32)) &&
        (!('whatsapp' in data) || isStr(data.whatsapp, 32)) &&
        (!('dateOfBirth' in data) || isStr(data.dateOfBirth, 20)) &&
        (!('gender' in data) || isStr(data.gender, 32)) &&
        (!('address' in data) || isStr(data.address, 300)) &&
        (!('emergencyContact' in data) || isStr(data.emergencyContact, 160)) &&
        (!('guardianName' in data) || isStr(data.guardianName, 120)) &&
        (!('guardianPhone' in data) || isStr(data.guardianPhone, 32)) &&
        (!('qualifications' in data) || isStr(data.qualifications, 300)) &&
        (!('specialization' in data) || isStr(data.specialization, 160));
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'branchId', 'protectedOwner', 'updatedAt']) &&
        isValidId(data.uid) &&
        isNonEmptyStr(data.email, 160) &&
        data.role in ['SUPER_ADMIN', 'ADMIN', 'BRANCH_MANAGER', 'ACCOUNTANT', 'ADMISSION_OFFICER', 'ACADEMIC_MANAGER', 'EXAMINER', 'CONTENT_MANAGER', 'COORDINATOR'] &&
        (!('branchId' in data) || isStr(data.branchId, 64)) &&
        (!('protectedOwner' in data) || data.protectedOwner is bool);
    }

    function isValidInvitation(data) {
      return data.keys().hasAll(['email', 'role', 'status', 'invitedBy', 'institutionId']) &&
        data.keys().hasOnly(['email', 'fullName', 'role', 'branchId', 'studentId', 'status', 'invitedBy', 'institutionId', 'createdAt']) &&
        isNonEmptyStr(data.email, 160) &&
        isNonEmptyStr(data.role, 40) &&
        data.status in ['pending', 'accepted', 'revoked'] &&
        isValidId(data.invitedBy) &&
        isNonEmptyStr(data.institutionId, 64) &&
        (!('fullName' in data) || isStr(data.fullName, 120)) &&
        (!('branchId' in data) || isStr(data.branchId, 64)) &&
        (!('studentId' in data) || isStr(data.studentId, 40));
    }

    function isValidRolePermission(data) {
      return data.keys().hasAll(['role', 'label', 'permissions']) &&
        data.keys().hasOnly(['role', 'label', 'description', 'permissions', 'updatedAt']) &&
        isNonEmptyStr(data.role, 40) &&
        isNonEmptyStr(data.label, 80) &&
        data.permissions is list && data.permissions.size() <= 40 &&
        (data.permissions.size() == 0 || data.permissions[0] is string) &&
        (!('description' in data) || isStr(data.description, 240));
    }

    function isValidBranch(data) {
      return data.keys().hasAll(['code', 'name', 'city', 'status', 'institutionId']) &&
        data.keys().hasOnly(['code', 'name', 'city', 'address', 'phone', 'managerName', 'coordinatorName', 'status', 'institutionId', 'createdAt']) &&
        isNonEmptyStr(data.code, 24) &&
        isNonEmptyStr(data.name, 120) &&
        isNonEmptyStr(data.city, 80) &&
        data.status in ['active', 'inactive'] &&
        isNonEmptyStr(data.institutionId, 64) &&
        (!('address' in data) || isStr(data.address, 240)) &&
        (!('phone' in data) || isStr(data.phone, 32)) &&
        (!('managerName' in data) || isStr(data.managerName, 120)) &&
        (!('coordinatorName' in data) || isStr(data.coordinatorName, 120));
    }

    function isValidCourse(data) {
      return data.keys().hasAll(['code', 'name', 'category', 'duration', 'mode', 'courseFeeLkr', 'status', 'institutionId']) &&
        data.keys().hasOnly([
          'code', 'slug', 'name', 'category', 'domain', 'description', 'imageUrl', 'bannerUrl', 'level',
          'duration', 'mode', 'courseFeeLkr', 'feeConfigured', 'isFree', 'currency',
          'registrationFeeLkr', 'certificateFeeLkr', 'installmentPlan', 'courseLanguage', 'branchIds',
          'admissionStatus', 'academicYear', 'featured', 'seoTitle', 'seoDescription',
          'lecturerId', 'lecturerName', 'batchName', 'startDate',
          'endDate', 'maxStudents', 'entryRequirements', 'learningOutcomes', 'syllabusTopics',
          'certificateEligible', 'status', 'institutionId', 'updatedAt'
        ]) &&
        isNonEmptyStr(data.code, 32) &&
        isNonEmptyStr(data.name, 160) &&
        data.category in ['Certificate', 'Diploma'] &&
        isNonEmptyStr(data.duration, 64) &&
        data.mode in ['Online', 'Physical', 'Hybrid'] &&
        isNonNegNum(data.courseFeeLkr) &&
        data.status in ['published', 'draft', 'archived'] &&
        isNonEmptyStr(data.institutionId, 64) &&
        (!('slug' in data) || isStr(data.slug, 140)) &&
        (!('domain' in data) || isStr(data.domain, 64)) &&
        (!('description' in data) || isStr(data.description, 1200)) &&
        (!('imageUrl' in data) || isStr(data.imageUrl, 240000)) &&
        (!('bannerUrl' in data) || isStr(data.bannerUrl, 240000)) &&
        (!('level' in data) || isStr(data.level, 40)) &&
        (!('feeConfigured' in data) || data.feeConfigured is bool) &&
        (!('isFree' in data) || data.isFree is bool) &&
        (!('currency' in data) || isStr(data.currency, 12)) &&
        (!('registrationFeeLkr' in data) || isNonNegNum(data.registrationFeeLkr)) &&
        (!('certificateFeeLkr' in data) || isNonNegNum(data.certificateFeeLkr)) &&
        (!('installmentPlan' in data) || isStr(data.installmentPlan, 120)) &&
        (!('courseLanguage' in data) || isStr(data.courseLanguage, 64)) &&
        (!('branchIds' in data) || (data.branchIds is list && data.branchIds.size() <= 20 && (data.branchIds.size() == 0 || data.branchIds[0] is string))) &&
        (!('admissionStatus' in data) || data.admissionStatus in ['open', 'closing_soon', 'closed', 'upcoming']) &&
        (!('academicYear' in data) || isStr(data.academicYear, 16)) &&
        (!('featured' in data) || data.featured is bool) &&
        (!('seoTitle' in data) || isStr(data.seoTitle, 180)) &&
        (!('seoDescription' in data) || isStr(data.seoDescription, 360)) &&
        (!('lecturerId' in data) || isStr(data.lecturerId, 128)) &&
        (!('lecturerName' in data) || isStr(data.lecturerName, 120)) &&
        (!('batchName' in data) || isStr(data.batchName, 80)) &&
        (!('startDate' in data) || isStr(data.startDate, 32)) &&
        (!('endDate' in data) || isStr(data.endDate, 32)) &&
        (!('maxStudents' in data) || isNonNegNum(data.maxStudents)) &&
        (!('entryRequirements' in data) || isStr(data.entryRequirements, 400)) &&
        (!('learningOutcomes' in data) || (data.learningOutcomes is list && data.learningOutcomes.size() <= 20 && (data.learningOutcomes.size() == 0 || data.learningOutcomes[0] is string))) &&
        (!('syllabusTopics' in data) || (data.syllabusTopics is list && data.syllabusTopics.size() <= 30 && (data.syllabusTopics.size() == 0 || data.syllabusTopics[0] is string))) &&
        (!('certificateEligible' in data) || data.certificateEligible is bool);
    }

    function isValidLesson(data) {
      return data.keys().hasAll(['courseId', 'moduleTitle', 'title', 'type', 'orderIndex', 'published']) &&
        data.keys().hasOnly(['courseId', 'moduleTitle', 'title', 'type', 'durationMinutes', 'orderIndex', 'videoUrl', 'resourceUrl', 'summary', 'published', 'updatedAt']) &&
        isValidId(data.courseId) &&
        isNonEmptyStr(data.moduleTitle, 140) &&
        isNonEmptyStr(data.title, 160) &&
        data.type in ['video', 'live', 'pdf', 'audio', 'reading'] &&
        isNonNegNum(data.orderIndex) &&
        data.published is bool &&
        (!('durationMinutes' in data) || isNonNegNum(data.durationMinutes)) &&
        (!('videoUrl' in data) || isStr(data.videoUrl, 500)) &&
        (!('resourceUrl' in data) || isStr(data.resourceUrl, 500)) &&
        (!('summary' in data) || isStr(data.summary, 2000));
    }

    function isValidApplication(data) {
      return data.keys().hasAll(['applicationNumber', 'fullName', 'email', 'phone', 'courseId', 'courseName', 'preferredMode', 'status', 'institutionId']) &&
        data.keys().hasOnly([
          'applicationNumber', 'fullName', 'email', 'phone', 'whatsapp', 'courseId', 'courseName',
          'preferredMode', 'branchId', 'batchName', 'highestQualification', 'documentNotes',
          'referralCode', 'status', 'rejectionReason', 'assignedStudentId', 'leadId', 'institutionId',
          'createdAt', 'updatedAt'
        ]) &&
        isNonEmptyStr(data.applicationNumber, 40) &&
        isNonEmptyStr(data.fullName, 120) &&
        isNonEmptyStr(data.email, 160) &&
        isNonEmptyStr(data.phone, 32) &&
        isValidId(data.courseId) &&
        isNonEmptyStr(data.courseName, 160) &&
        data.preferredMode in ['Online', 'Physical', 'Hybrid'] &&
        data.status in ['Draft', 'Submitted', 'Under Review', 'Documents Required', 'Approved', 'Rejected', 'Payment Pending', 'Enrolled'] &&
        isNonEmptyStr(data.institutionId, 64) &&
        (!('whatsapp' in data) || isStr(data.whatsapp, 32)) &&
        (!('branchId' in data) || isStr(data.branchId, 64)) &&
        (!('batchName' in data) || isStr(data.batchName, 80)) &&
        (!('highestQualification' in data) || isStr(data.highestQualification, 160)) &&
        (!('documentNotes' in data) || isStr(data.documentNotes, 400)) &&
        (!('referralCode' in data) || isStr(data.referralCode, 40)) &&
        (!('rejectionReason' in data) || isStr(data.rejectionReason, 300)) &&
        (!('assignedStudentId' in data) || isStr(data.assignedStudentId, 40)) &&
        (!('leadId' in data) || isStr(data.leadId, 128));
    }

    function isValidApplicationTracker(data) {
      return data.keys().hasAll(['applicationNumber', 'courseName', 'status']) &&
        data.keys().hasOnly(['applicationNumber', 'applicantInitials', 'courseName', 'status', 'assignedStudentId', 'updatedAt']) &&
        isNonEmptyStr(data.applicationNumber, 40) &&
        isNonEmptyStr(data.courseName, 160) &&
        isNonEmptyStr(data.status, 40) &&
        (!('applicantInitials' in data) || isStr(data.applicantInitials, 24)) &&
        (!('assignedStudentId' in data) || isStr(data.assignedStudentId, 40));
    }

    function isValidEnrollment(data) {
      return data.keys().hasAll(['userId', 'studentId', 'studentName', 'courseId', 'courseName', 'status', 'institutionId']) &&
        data.keys().hasOnly(['userId', 'studentId', 'studentName', 'courseId', 'courseName', 'branchId', 'batchName', 'progressPercent', 'status', 'leadId', 'institutionId', 'enrolledAt']) &&
        isValidId(data.userId) &&
        isNonEmptyStr(data.studentId, 40) &&
        isNonEmptyStr(data.studentName, 120) &&
        isValidId(data.courseId) &&
        isNonEmptyStr(data.courseName, 160) &&
        data.status in ['active', 'completed', 'suspended'] &&
        isNonEmptyStr(data.institutionId, 64) &&
        (!('branchId' in data) || isStr(data.branchId, 64)) &&
        (!('batchName' in data) || isStr(data.batchName, 80)) &&
        (!('leadId' in data) || isStr(data.leadId, 128)) &&
        (!('progressPercent' in data) || (isNonNegNum(data.progressPercent) && data.progressPercent <= 100));
    }

    function isValidLearningProgress(data) {
      return data.keys().hasAll(['userId', 'courseId', 'lessonId', 'completed']) &&
        data.keys().hasOnly(['userId', 'courseId', 'lessonId', 'completed', 'lastPositionSec', 'updatedAt']) &&
        isValidId(data.userId) &&
        isValidId(data.courseId) &&
        isValidId(data.lessonId) &&
        data.completed is bool &&
        (!('lastPositionSec' in data) || isNonNegNum(data.lastPositionSec));
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['courseId', 'date', 'userId', 'studentId', 'studentName', 'mode', 'status', 'markedBy']) &&
        data.keys().hasOnly(['courseId', 'courseName', 'batchName', 'branchId', 'date', 'userId', 'studentId', 'studentName', 'mode', 'status', 'markedBy', 'correctionReason', 'updatedAt']) &&
        isValidId(data.courseId) &&
        isNonEmptyStr(data.date, 20) &&
        isValidId(data.userId) &&
        isNonEmptyStr(data.studentId, 40) &&
        isNonEmptyStr(data.studentName, 120) &&
        data.mode in ['Online', 'Physical', 'QR'] &&
        data.status in ['Present', 'Late', 'Absent', 'Excused'] &&
        isValidId(data.markedBy) &&
        (!('courseName' in data) || isStr(data.courseName, 160)) &&
        (!('batchName' in data) || isStr(data.batchName, 80)) &&
        (!('branchId' in data) || isStr(data.branchId, 64)) &&
        (!('correctionReason' in data) || isStr(data.correctionReason, 240));
    }

    function isValidAssignment(data) {
      return data.keys().hasAll(['courseId', 'title', 'dueDate', 'maxMarks', 'createdBy']) &&
        data.keys().hasOnly(['courseId', 'courseName', 'title', 'instructions', 'dueDate', 'maxMarks', 'createdBy', 'createdAt']) &&
        isValidId(data.courseId) &&
        isNonEmptyStr(data.title, 160) &&
        isNonEmptyStr(data.dueDate, 32) &&
        isNonNegNum(data.maxMarks) &&
        isValidId(data.createdBy) &&
        (!('courseName' in data) || isStr(data.courseName, 160)) &&
        (!('instructions' in data) || isStr(data.instructions, 2000));
    }

    function isValidSubmission(data) {
      return data.keys().hasAll(['assignmentId', 'courseId', 'userId', 'studentName', 'status']) &&
        data.keys().hasOnly(['assignmentId', 'assignmentTitle', 'courseId', 'userId', 'studentName', 'submissionUrl', 'notes', 'status', 'marks', 'feedback', 'evaluatedBy', 'updatedAt']) &&
        isValidId(data.assignmentId) &&
        isValidId(data.courseId) &&
        isValidId(data.userId) &&
        isNonEmptyStr(data.studentName, 120) &&
        data.status in ['Submitted', 'Late', 'Evaluated', 'Resubmit Requested'] &&
        (!('assignmentTitle' in data) || isStr(data.assignmentTitle, 160)) &&
        (!('submissionUrl' in data) || isStr(data.submissionUrl, 500)) &&
        (!('notes' in data) || isStr(data.notes, 1200)) &&
        (!('marks' in data) || isNonNegNum(data.marks)) &&
        (!('feedback' in data) || isStr(data.feedback, 1200)) &&
        (!('evaluatedBy' in data) || isStr(data.evaluatedBy, 128));
    }

    function isValidExamination(data) {
      return data.keys().hasAll(['courseId', 'title', 'durationMinutes', 'passPercent', 'approvalStatus', 'createdBy']) &&
        data.keys().hasOnly(['courseId', 'courseName', 'title', 'durationMinutes', 'passPercent', 'questions', 'approvalStatus', 'aiAssisted', 'createdBy', 'approvedBy', 'updatedAt']) &&
        isValidId(data.courseId) &&
        isNonEmptyStr(data.title, 160) &&
        isNonNegNum(data.durationMinutes) &&
        isNonNegNum(data.passPercent) &&
        data.approvalStatus in ['draft', 'approved', 'archived'] &&
        isValidId(data.createdBy) &&
        (!('courseName' in data) || isStr(data.courseName, 160)) &&
        (!('questions' in data) || (data.questions is list && data.questions.size() <= 50)) &&
        (!('aiAssisted' in data) || data.aiAssisted is bool) &&
        (!('approvedBy' in data) || isStr(data.approvedBy, 128));
    }

    function isValidExamResult(data) {
      return data.keys().hasAll(['examId', 'courseId', 'userId', 'studentName', 'autoScorePercent', 'resultStatus']) &&
        data.keys().hasOnly(['examId', 'examTitle', 'courseId', 'userId', 'studentName', 'autoScorePercent', 'finalScorePercent', 'grade', 'passed', 'resultStatus', 'aiFeedbackDraft', 'approvedBy', 'submittedAt']) &&
        isValidId(data.examId) &&
        isValidId(data.courseId) &&
        isValidId(data.userId) &&
        isNonEmptyStr(data.studentName, 120) &&
        isNonNegNum(data.autoScorePercent) &&
        data.resultStatus in ['pending_approval', 'published'] &&
        (!('examTitle' in data) || isStr(data.examTitle, 160)) &&
        (!('finalScorePercent' in data) || isNonNegNum(data.finalScorePercent)) &&
        (!('grade' in data) || isStr(data.grade, 16)) &&
        (!('passed' in data) || data.passed is bool) &&
        (!('aiFeedbackDraft' in data) || isStr(data.aiFeedbackDraft, 1200)) &&
        (!('approvedBy' in data) || isStr(data.approvedBy, 128));
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['userId', 'studentName', 'courseName', 'feeType', 'amountLkr', 'method', 'status', 'institutionId']) &&
        data.keys().hasOnly([
          'userId', 'studentId', 'studentName', 'courseId', 'courseName', 'branchId',
          'feeType', 'amountLkr', 'method', 'referenceNo', 'proofNotes', 'status',
          'receiptNumber', 'verifiedBy', 'rejectionReason', 'institutionId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        isNonEmptyStr(data.studentName, 120) &&
        isNonEmptyStr(data.courseName, 160) &&
        data.feeType in ['Registration', 'Course Fee', 'Installment', 'Certificate Fee'] &&
        isNonNegNum(data.amountLkr) &&
        data.method in ['Cash', 'Bank Transfer', 'Card', 'Online Gateway', 'QR Payment'] &&
        data.status in ['Pending Verification', 'Verified', 'Rejected', 'Refunded'] &&
        isNonEmptyStr(data.institutionId, 64) &&
        (!('studentId' in data) || isStr(data.studentId, 40)) &&
        (!('courseId' in data) || isStr(data.courseId, 128)) &&
        (!('branchId' in data) || isStr(data.branchId, 64)) &&
        (!('referenceNo' in data) || isStr(data.referenceNo, 80)) &&
        (!('proofNotes' in data) || isStr(data.proofNotes, 400)) &&
        (!('receiptNumber' in data) || isStr(data.receiptNumber, 40)) &&
        (!('verifiedBy' in data) || isStr(data.verifiedBy, 128)) &&
        (!('rejectionReason' in data) || isStr(data.rejectionReason, 240));
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['title', 'category', 'amountLkr', 'date', 'recordedBy', 'institutionId']) &&
        data.keys().hasOnly(['title', 'category', 'branchId', 'amountLkr', 'date', 'recordedBy', 'institutionId']) &&
        isNonEmptyStr(data.title, 140) &&
        isNonEmptyStr(data.category, 64) &&
        isNonNegNum(data.amountLkr) &&
        isNonEmptyStr(data.date, 20) &&
        isValidId(data.recordedBy) &&
        isNonEmptyStr(data.institutionId, 64) &&
        (!('branchId' in data) || isStr(data.branchId, 64));
    }

    function isValidCertificate(data) {
      return data.keys().hasAll(['certificateNumber', 'studentName', 'courseName', 'issueDate', 'issuingInstitution', 'status', 'institutionId']) &&
        data.keys().hasOnly([
          'certificateNumber', 'userId', 'studentId', 'studentName', 'courseId', 'courseName',
          'category', 'completionDate', 'issueDate', 'issuingInstitution', 'signatoryName',
          'status', 'revocationReason', 'issuedBy', 'institutionId'
        ]) &&
        isNonEmptyStr(data.certificateNumber, 48) &&
        isNonEmptyStr(data.studentName, 120) &&
        isNonEmptyStr(data.courseName, 160) &&
        isNonEmptyStr(data.issueDate, 24) &&
        isNonEmptyStr(data.issuingInstitution, 120) &&
        data.status in ['Issued', 'Revoked', 'Reissued'] &&
        isNonEmptyStr(data.institutionId, 64) &&
        (!('userId' in data) || isStr(data.userId, 128)) &&
        (!('studentId' in data) || isStr(data.studentId, 40)) &&
        (!('courseId' in data) || isStr(data.courseId, 128)) &&
        (!('category' in data) || data.category in ['Certificate', 'Diploma']) &&
        (!('completionDate' in data) || isStr(data.completionDate, 24)) &&
        (!('signatoryName' in data) || isStr(data.signatoryName, 120)) &&
        (!('revocationReason' in data) || isStr(data.revocationReason, 240)) &&
        (!('issuedBy' in data) || isStr(data.issuedBy, 128));
    }

    function isValidLibraryResource(data) {
      return data.keys().hasAll(['title', 'category', 'resourceType', 'accessLevel', 'uploadedBy']) &&
        data.keys().hasOnly(['title', 'category', 'courseId', 'resourceType', 'version', 'url', 'summary', 'accessLevel', 'uploadedBy', 'updatedAt']) &&
        isNonEmptyStr(data.title, 160) &&
        isNonEmptyStr(data.category, 64) &&
        data.resourceType in ['E-Book', 'PDF Notes', 'Template', 'Recorded Lecture', 'Project Brief'] &&
        data.accessLevel in ['public', 'enrolled'] &&
        isValidId(data.uploadedBy) &&
        (!('courseId' in data) || isStr(data.courseId, 128)) &&
        (!('version' in data) || isStr(data.version, 24)) &&
        (!('url' in data) || isStr(data.url, 500)) &&
        (!('summary' in data) || isStr(data.summary, 600));
    }

    function isValidCommunityPost(data) {
      return data.keys().hasAll(['userId', 'authorName', 'postType', 'title', 'body', 'moderatedStatus']) &&
