          'approvedByUid', 'approvedByName', 'publishedAt', 'institutionId', 'createdAt', 'updatedAt'
        ]) &&
        isNonEmptyStr(data.syllabusId, 64) &&
        isValidId(data.courseId) &&
        isNonEmptyStr(data.courseName, 160) &&
        isNonEmptyStr(data.academicYear, 24) &&
        isNonNegNum(data.versionNumber) &&
        data.status in ['Draft', 'Pending Review', 'Approved', 'Published', 'Archived'] &&
        data.modules is list && data.modules.size() <= 60 &&
        isValidId(data.createdByUid) &&
        isNonEmptyStr(data.createdByName, 120) &&
        isNonEmptyStr(data.institutionId, 64) &&
        isNonEmptyStr(data.createdAt, 40) &&
        (!('programmeName' in data) || isStr(data.programmeName, 160)) &&
        (!('changeSummary' in data) || isStr(data.changeSummary, 500)) &&
        (!('totalCourseDuration' in data) || isStr(data.totalCourseDuration, 64)) &&
        (!('finalAssessment' in data) || isStr(data.finalAssessment, 1500)) &&
        (!('announcementNote' in data) || isStr(data.announcementNote, 600)) &&
        (!('attachment' in data) || data.attachment == null || data.attachment is map) &&
        (!('supportingResources' in data) || (data.supportingResources is list && data.supportingResources.size() <= 20)) &&
        (!('restoredFromVersion' in data) || isNonNegNum(data.restoredFromVersion)) &&
        (!('createdByRole' in data) || isStr(data.createdByRole, 40)) &&
        (!('approvedByUid' in data) || isStr(data.approvedByUid, 128)) &&
        (!('approvedByName' in data) || isStr(data.approvedByName, 120)) &&
        (!('publishedAt' in data) || isStr(data.publishedAt, 40)) &&
        (!('updatedAt' in data) || isStr(data.updatedAt, 40));
    }

    function isValidModuleProgress(data) {
      return data.keys().hasAll([
          'userId', 'courseId', 'syllabusId', 'completedModuleIds', 'completedTopicIds',
          'completedActivityIds', 'completedAssignmentIds', 'totalTrackableItems',
          'completedTrackableItems', 'progressPercent', 'institutionId', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'courseId', 'syllabusId', 'versionNumber', 'completedModuleIds',
          'completedTopicIds', 'completedActivityIds', 'completedAssignmentIds',
          'totalTrackableItems', 'completedTrackableItems', 'progressPercent',
          'institutionId', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        isValidId(data.courseId) &&
        isNonEmptyStr(data.syllabusId, 64) &&
        data.completedModuleIds is list && data.completedModuleIds.size() <= 100 &&
        (data.completedModuleIds.size() == 0 || data.completedModuleIds[0] is string) &&
        data.completedTopicIds is list && data.completedTopicIds.size() <= 500 &&
        (data.completedTopicIds.size() == 0 || data.completedTopicIds[0] is string) &&
        data.completedActivityIds is list && data.completedActivityIds.size() <= 300 &&
        (data.completedActivityIds.size() == 0 || data.completedActivityIds[0] is string) &&
        data.completedAssignmentIds is list && data.completedAssignmentIds.size() <= 300 &&
        (data.completedAssignmentIds.size() == 0 || data.completedAssignmentIds[0] is string) &&
        isNonNegNum(data.totalTrackableItems) &&
        isNonNegNum(data.completedTrackableItems) &&
        isNonNegNum(data.progressPercent) && data.progressPercent <= 100 &&
        isNonEmptyStr(data.institutionId, 64) &&
        isNonEmptyStr(data.updatedAt, 40) &&
        (!('versionNumber' in data) || isNonNegNum(data.versionNumber));
    }

    // 4. COLLECTION RULES

    match /test/connection {
      allow get: if true;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && (request.auth.uid == userId || isAdminStaff());
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.uid == request.auth.uid);

      allow create: if isValidId(userId) && isVerifiedUser() && isValidUserProfile(incoming()) && (
        isSuperAdminOwner() ||
        (
          request.auth.uid == userId &&
          incoming().uid == userId &&
          incoming().role == 'STUDENT' &&
          incoming().accountStatus == 'active'
        )
      );

      allow update: if isValidId(userId) && isVerifiedUser() && isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid && (
        isSuperAdminOwner() ||
        (
          isAdminStaff() &&
          existing().role != 'SUPER_ADMIN' &&
          incoming().role != 'SUPER_ADMIN'
        ) ||
        (
          request.auth.uid == userId &&
          incoming().role == existing().role &&
          incoming().accountStatus == existing().accountStatus &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'xpPoints', 'streakDays', 'level', 'updatedAt'])
        )
      );

      allow delete: if isValidId(userId) && isSuperAdminOwner() && existing().role != 'SUPER_ADMIN';

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && isVerifiedUser() && (request.auth.uid == userId || isAdminStaff());
        allow list: if isSuperAdminOwner() || (isVerifiedUser() && request.auth.uid == userId);
        allow create, update: if isValidId(userId) && isValidId(docId) && isVerifiedUser() &&
          isValidUserPii(incoming()) && incoming().uid == userId && (
            request.auth.uid == userId || isAdminStaff()
          );
        allow delete: if isValidId(userId) && isValidId(docId) && isSuperAdminOwner();
      }
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && (request.auth.uid == userId || isSuperAdminOwner());
      allow list: if isSuperAdminOwner();
      allow create, update: if isValidId(userId) && isSuperAdminOwner() && isValidAdminRecord(incoming());
      allow delete: if isValidId(userId) && isSuperAdminOwner() && existing().protectedOwner != true;
    }

    match /roleInvitations/{invitationId} {
      allow get: if isValidId(invitationId) && isVerifiedUser() && (isAdminStaff() || resource.data.email == request.auth.token.email);
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.email == request.auth.token.email);
      allow create: if isValidId(invitationId) && isAdminStaff() && isValidInvitation(incoming()) && incoming().invitedBy == request.auth.uid;
      allow update: if isValidId(invitationId) && isVerifiedUser() && isValidInvitation(incoming()) && (
        isAdminStaff() ||
        (
          existing().email == request.auth.token.email &&
          existing().status == 'pending' &&
          incoming().status == 'accepted' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        )
      );
      allow delete: if isValidId(invitationId) && isSuperAdminOwner();
    }

    match /rolePermissions/{roleKey} {
      allow get: if isValidId(roleKey) && isVerifiedUser();
      allow list: if isSuperAdminOwner();
      allow create, update: if isValidId(roleKey) && isSuperAdminOwner() && isValidRolePermission(incoming());
      allow delete: if false;
    }

    match /branches/{branchId} {
      allow get: if isValidId(branchId);
      allow list: if resource.data.status == 'active' || isSuperAdminOwner();
      allow create, update: if isValidId(branchId) && isSuperAdminOwner() && isValidBranch(incoming());
      allow delete: if isValidId(branchId) && isSuperAdminOwner();
    }

    match /courses/{courseId} {
      allow get: if isValidId(courseId) && (resource.data.status == 'published' || isAdminStaff() || isLecturer());
      allow list: if resource.data.status == 'published' || isSuperAdminOwner();
      allow create, update: if isValidId(courseId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ACADEMIC_MANAGER']) && isValidCourse(incoming());
      allow delete: if isValidId(courseId) && isSuperAdminOwner();

      match /lessons/{lessonId} {
        allow get: if isValidId(courseId) && isValidId(lessonId) && isVerifiedUser() &&
          exists(/databases/$(database)/documents/courses/$(courseId));
        allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.published == true);
        allow create, update: if isValidId(courseId) && isValidId(lessonId) && isLecturer() &&
          isValidLesson(incoming()) && incoming().courseId == courseId &&
          exists(/databases/$(database)/documents/courses/$(courseId));
        allow delete: if isValidId(courseId) && isValidId(lessonId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ACADEMIC_MANAGER']);
      }
    }

    match /applications/{applicationId} {
      allow get: if isValidId(applicationId) && isAdminStaff();
      allow list: if isSuperAdminOwner();
      allow create: if isValidId(applicationId) && isValidApplication(incoming()) && incoming().status == 'Submitted';
      allow update: if isValidId(applicationId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ADMISSION_OFFICER', 'BRANCH_MANAGER', 'COORDINATOR']) && isValidApplication(incoming());
      allow delete: if isValidId(applicationId) && isSuperAdminOwner();
    }

    match /applicationTrackers/{applicationNumber} {
      allow get: if isValidId(applicationNumber);
      allow list: if isSuperAdminOwner();
      allow create: if isValidId(applicationNumber) && isValidApplicationTracker(incoming()) && incoming().status == 'Submitted';
      allow update: if isValidId(applicationNumber) && hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ADMISSION_OFFICER', 'BRANCH_MANAGER', 'COORDINATOR']) && isValidApplicationTracker(incoming());
      allow delete: if isValidId(applicationNumber) && isSuperAdminOwner();
    }

    match /enrollments/{enrollmentId} {
      allow get: if isValidId(enrollmentId) && isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdminStaff() || isLecturer());
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(enrollmentId) && isVerifiedUser() && isValidEnrollment(incoming()) && (
        hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ADMISSION_OFFICER', 'ACADEMIC_MANAGER', 'BRANCH_MANAGER'])
      );
      allow update: if isValidId(enrollmentId) && isVerifiedUser() && isValidEnrollment(incoming()) &&
        incoming().userId == existing().userId && (
        hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ACADEMIC_MANAGER']) ||
        (
          existing().userId == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['progressPercent'])
        )
      );
      allow delete: if isValidId(enrollmentId) && isSuperAdminOwner();
    }

    match /learningProgress/{progressId} {
      allow get: if isValidId(progressId) && isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdminStaff());
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow create, update: if isValidId(progressId) && isVerifiedUser() &&
        isValidLearningProgress(incoming()) && incoming().userId == request.auth.uid;
      allow delete: if isValidId(progressId) && isSuperAdminOwner();
    }

    match /attendance/{attendanceId} {
      allow get: if isValidId(attendanceId) && isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdminStaff() || isLecturer());
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(attendanceId) && isLecturer() && isValidAttendance(incoming()) && incoming().markedBy == request.auth.uid;
      allow update: if isValidId(attendanceId) && (isLecturer() || isAdminStaff()) && isValidAttendance(incoming()) &&
        incoming().userId == existing().userId && incoming().date == existing().date;
      allow delete: if isValidId(attendanceId) && isSuperAdminOwner();
    }

    match /assignments/{assignmentId} {
      allow get: if isValidId(assignmentId) && isVerifiedUser();
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.maxMarks >= 0);
      allow create, update: if isValidId(assignmentId) && isLecturer() && isValidAssignment(incoming());
      allow delete: if isValidId(assignmentId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ACADEMIC_MANAGER']);
    }

    match /submissions/{submissionId} {
      allow get: if isValidId(submissionId) && isVerifiedUser() && (resource.data.userId == request.auth.uid || isLecturer() || isAdminStaff());
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(submissionId) && isVerifiedUser() && isValidSubmission(incoming()) &&
        incoming().userId == request.auth.uid && incoming().status in ['Submitted', 'Late'];
      allow update: if isValidId(submissionId) && isVerifiedUser() && isValidSubmission(incoming()) &&
        incoming().userId == existing().userId && (
        isLecturer() || isAdminStaff() ||
        (
          existing().userId == request.auth.uid &&
          existing().status != 'Evaluated' &&
          incoming().status in ['Submitted', 'Late'] &&
          incoming().diff(existing()).affectedKeys().hasOnly(['submissionUrl', 'notes', 'status', 'updatedAt'])
        )
      );
      allow delete: if isValidId(submissionId) && isSuperAdminOwner();
    }

    match /examinations/{examId} {
      allow get: if isValidId(examId) && isVerifiedUser() && (resource.data.approvalStatus == 'approved' || isLecturer() || isAdminStaff());
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.approvalStatus == 'approved');
      allow create, update: if isValidId(examId) && isLecturer() && isValidExamination(incoming());
      allow delete: if isValidId(examId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'EXAMINER']);
    }

    match /examResults/{resultId} {
      allow get: if isValidId(resultId) && isVerifiedUser() && (resource.data.userId == request.auth.uid || isLecturer() || isAdminStaff());
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(resultId) && isVerifiedUser() && isValidExamResult(incoming()) &&
        incoming().userId == request.auth.uid && incoming().resultStatus == 'pending_approval';
      allow update: if isValidId(resultId) && (isLecturer() || hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'EXAMINER'])) &&
        isValidExamResult(incoming()) && incoming().userId == existing().userId;
      allow delete: if isValidId(resultId) && isSuperAdminOwner();
    }

    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && isVerifiedUser() && (resource.data.userId == request.auth.uid || hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ACCOUNTANT', 'BRANCH_MANAGER']));
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(paymentId) && isVerifiedUser() && isValidPayment(incoming()) && (
        (
          incoming().userId == request.auth.uid &&
          incoming().status == 'Pending Verification' &&
          !('receiptNumber' in incoming()) &&
          !('verifiedBy' in incoming())
        ) ||
        hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ACCOUNTANT'])
      );
      allow update: if isValidId(paymentId) && isVerifiedUser() && isValidPayment(incoming()) &&
        incoming().userId == existing().userId && (
        (
          existing().status == 'Verified' &&
          isSuperAdminOwner() &&
          incoming().status == 'Refunded' &&
          incoming().amountLkr == existing().amountLkr &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'rejectionReason', 'updatedAt'])
        ) ||
        (
          existing().status != 'Verified' &&
          hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ACCOUNTANT']) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'receiptNumber', 'verifiedBy', 'rejectionReason', 'updatedAt'])
        )
      );
      allow delete: if false;
    }

    match /expenses/{expenseId} {
      allow get: if isValidId(expenseId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ACCOUNTANT']);
      allow list: if isSuperAdminOwner();
      allow create, update: if isValidId(expenseId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ACCOUNTANT']) && isValidExpense(incoming());
      allow delete: if isValidId(expenseId) && isSuperAdminOwner();
    }

    match /certificates/{certificateNumber} {
      allow get: if isValidId(certificateNumber);
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow create, update: if isValidId(certificateNumber) && hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ACADEMIC_MANAGER', 'EXAMINER']) && isValidCertificate(incoming());
      allow delete: if false;
    }

    match /libraryResources/{resourceId} {
      allow get: if isValidId(resourceId) && (resource.data.accessLevel == 'public' || isVerifiedUser());
      allow list: if resource.data.accessLevel == 'public' || isSuperAdminOwner() || (isVerifiedUser() && resource.data.accessLevel == 'enrolled');
      allow create, update: if isValidId(resourceId) && (isLecturer() || isAdminStaff()) && isValidLibraryResource(incoming());
      allow delete: if isValidId(resourceId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'CONTENT_MANAGER']);
    }

    match /communityPosts/{postId} {
      allow get: if isValidId(postId) && (resource.data.moderatedStatus == 'active' || isAdminStaff());
      allow list: if resource.data.moderatedStatus == 'active' || isSuperAdminOwner();
      allow create: if isValidId(postId) && isVerifiedUser() && isValidCommunityPost(incoming()) &&
        incoming().userId == request.auth.uid && incoming().moderatedStatus == 'active';
      allow update: if isValidId(postId) && isVerifiedUser() && isValidCommunityPost(incoming()) &&
        incoming().userId == existing().userId && (
        isAdminStaff() ||
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'moderatedStatus']) &&
          incoming().moderatedStatus in ['active', 'reported']
        )
      );
      allow delete: if isValidId(postId) && (isSuperAdminOwner() || existing().userId == request.auth.uid);
    }

    match /affiliates/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && (request.auth.uid == userId || isAdminStaff());
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(userId) && isVerifiedUser() && isValidAffiliate(incoming()) && (
        isSuperAdminOwner() ||
        (request.auth.uid == userId && incoming().userId == userId && incoming().status == 'pending_review' && incoming().approvedCommissionLkr == 0)
      );
      allow update: if isValidId(userId) && isVerifiedUser() && isValidAffiliate(incoming()) &&
        incoming().userId == existing().userId && (
        isSuperAdminOwner() ||
        (
          request.auth.uid == userId &&
          incoming().commissionRatePercent == existing().commissionRatePercent &&
          incoming().approvedCommissionLkr == existing().approvedCommissionLkr &&
          incoming().diff(existing()).affectedKeys().hasOnly(['withdrawalRequestedLkr', 'updatedAt'])
        )
      );
      allow delete: if isValidId(userId) && isSuperAdminOwner();
    }

    match /cmsItems/{itemId} {
      allow get: if isValidId(itemId) && (resource.data.status == 'published' || isAdminStaff());
      allow list: if resource.data.status == 'published' || isSuperAdminOwner();
      allow create, update: if isValidId(itemId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'CONTENT_MANAGER']) && isValidCmsItem(incoming());
      allow delete: if isValidId(itemId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'CONTENT_MANAGER']);
    }

    match /aiConversations/{conversationId} {
      allow get: if isValidId(conversationId) && isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(conversationId) && isVerifiedUser() && isValidAIConversation(incoming()) && incoming().userId == request.auth.uid;
      allow update: if false;
      allow delete: if isValidId(conversationId) && isVerifiedUser() && existing().userId == request.auth.uid;
    }

    match /careerProfiles/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && (request.auth.uid == userId || isAdminStaff());
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow create, update: if isValidId(userId) && isVerifiedUser() && isValidCareerProfile(incoming()) && incoming().userId == request.auth.uid;
      allow delete: if isValidId(userId) && isSuperAdminOwner();
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdminStaff());
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(notificationId) && isValidNotification(incoming()) && (
        isAdminStaff() ||
        (
          incoming().userId == 'super-admin-inbox' &&
          incoming().read == false &&
          'category' in incoming() &&
          incoming().category == 'programme_enquiry'
        )
      );
      allow update: if isValidId(notificationId) && isVerifiedUser() && isValidNotification(incoming()) &&
        incoming().userId == existing().userId && (
          isSuperAdminOwner() ||
          (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']))
        );
      allow delete: if isValidId(notificationId) && isSuperAdminOwner();
    }

    match /inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && isAdminStaff();
      allow list: if isSuperAdminOwner();
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming()) && incoming().status == 'new';
      allow update: if isValidId(inquiryId) && isAdminStaff() && isValidInquiry(incoming());
      allow delete: if isValidId(inquiryId) && isSuperAdminOwner();
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isSuperAdminOwner();
      allow list: if isSuperAdminOwner();
      allow create: if isValidId(logId) && isVerifiedUser() && isValidAuditLog(incoming()) && incoming().actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /systemSettings/{institutionId} {
      allow get: if isValidId(institutionId);
      allow list: if isSuperAdminOwner();
      allow create, update: if isValidId(institutionId) && isSuperAdminOwner() && isValidSystemSettings(incoming());
      allow delete: if false;
    }

    match /migratedStudents/{studentId} {
      allow get: if isValidId(studentId) && isSuperAdminOwner();
      allow list: if isSuperAdminOwner();
      allow create: if isValidId(studentId) && isSuperAdminOwner() && isValidMigratedStudent(incoming()) && incoming().studentId == studentId;
      allow update: if isValidId(studentId) && isSuperAdminOwner() && isValidMigratedStudent(incoming()) && incoming().studentId == existing().studentId;
      allow delete: if isValidId(studentId) && isSuperAdminOwner();
    }

    match /migrationBatches/{batchId} {
      allow get: if isValidId(batchId) && isSuperAdminOwner();
      allow list: if isSuperAdminOwner();
      allow create: if isValidId(batchId) && isSuperAdminOwner() && isValidMigrationBatch(incoming()) && incoming().importedByUid == request.auth.uid;
      allow update: if isValidId(batchId) && isSuperAdminOwner() && isValidMigrationBatch(incoming()) && incoming().importedByUid == existing().importedByUid;
      allow delete: if false;
    }

    match /specialProgrammes/{programmeId} {
      allow get: if isValidId(programmeId) && (resource.data.status == 'published' || isAdminStaff());
      allow list: if resource.data.status == 'published' || isSuperAdminOwner();
      allow create, update: if isValidId(programmeId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'CONTENT_MANAGER']) && isValidSpecialProgramme(incoming());
      allow delete: if isValidId(programmeId) && isSuperAdminOwner();
    }

    match /programmeEnquiries/{enquiryId} {
      allow get: if isValidId(enquiryId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ADMISSION_OFFICER']);
      allow list: if isSuperAdminOwner();
      allow create: if isValidId(enquiryId) && isValidProgrammeEnquiry(incoming()) && incoming().status == 'new';
      allow update: if isValidId(enquiryId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ADMISSION_OFFICER']) && isValidProgrammeEnquiry(incoming());
      allow delete: if isValidId(enquiryId) && isSuperAdminOwner();
    }

    // MODULE 1: LEAD MANAGEMENT & BULK IMPORT CRM (Strictly hidden from Lecturers and Students)
    match /leads/{leadId} {
      allow get: if isValidId(leadId) && (
        hasStaffRole(['SUPER_ADMIN', 'ADMIN']) ||
        (hasStaffRole(['BRANCH_MANAGER']) && resource.data.preferredBranchId == get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.branchId) ||
        (hasStaffRole(['ADMISSION_OFFICER', 'COORDINATOR']) && resource.data.assignedToUid == request.auth.uid)
      );
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.assignedToUid == request.auth.uid) || (isVerifiedUser() && resource.data.createdByUid == request.auth.uid);
      allow create: if isValidId(leadId) && isVerifiedUser() && isValidLead(incoming()) &&
        hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'BRANCH_MANAGER', 'ADMISSION_OFFICER', 'COORDINATOR']);
      allow update: if isValidId(leadId) && isVerifiedUser() && isValidLead(incoming()) &&
        incoming().leadId == existing().leadId && (
        hasStaffRole(['SUPER_ADMIN', 'ADMIN']) ||
        (
          hasStaffRole(['BRANCH_MANAGER']) &&
          existing().preferredBranchId == get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.branchId &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'fullName', 'mobile', 'normalizedMobile', 'whatsapp', 'email', 'dateOfBirth', 'gender',
            'address', 'city', 'district', 'interestedCourseId', 'interestedCourseName', 'courseCategory',
            'preferredStudyMode', 'educationQualification', 'academicYear', 'leadSource', 'campaignName',
            'adReference', 'socialMediaPlatform', 'referralName', 'status', 'assignedToUid',
            'assignedToName', 'lastContactDate', 'nextFollowUpDate', 'followUpNotes', 'priority',
            'notInterestedReason', 'convertedApplicationId', 'convertedStudentId', 'convertedAt',
            'convertedByUid', 'convertedByName', 'archived', 'updatedAt'
          ])
        ) ||
        (
          hasStaffRole(['ADMISSION_OFFICER', 'COORDINATOR']) &&
          existing().assignedToUid == request.auth.uid &&
          incoming().assignedToUid == existing().assignedToUid &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'lastContactDate', 'nextFollowUpDate', 'followUpNotes', 'priority',
            'notInterestedReason', 'interestedCourseId', 'interestedCourseName',
            'preferredStudyMode', 'convertedApplicationId', 'convertedStudentId',
            'convertedAt', 'convertedByUid', 'convertedByName', 'updatedAt'
          ])
        )
      );
      allow delete: if isValidId(leadId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN']);
    }

    match /leadActivities/{activityId} {
      allow get: if isValidId(activityId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'BRANCH_MANAGER', 'ADMISSION_OFFICER', 'COORDINATOR']);
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.actorUid == request.auth.uid);
      allow create: if isValidId(activityId) && isVerifiedUser() && isValidLeadActivity(incoming()) &&
        incoming().actorUid == request.auth.uid &&
        hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'BRANCH_MANAGER', 'ADMISSION_OFFICER', 'COORDINATOR']);
      allow update, delete: if false;
    }

    match /leadImportBatches/{batchId} {
      allow get: if isValidId(batchId) && hasStaffRole(['SUPER_ADMIN', 'ADMIN']);
      allow list: if isSuperAdminOwner();
      allow create: if isValidId(batchId) && isVerifiedUser() && isValidLeadImportBatch(incoming()) &&
        incoming().importedByUid == request.auth.uid &&
        hasStaffRole(['SUPER_ADMIN', 'ADMIN']);
      allow update, delete: if false;
    }

    // MODULE 2: COURSE SYLLABUS UPLOAD, BUILDER, VERSIONING & STUDENT PROGRESS
    match /syllabuses/{syllabusId} {
      allow get: if isValidId(syllabusId) && isVerifiedUser() && (
        resource.data.publishedStatus == 'published' || isAdminStaff() || isLecturer()
      );
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.publishedStatus == 'published') || (isVerifiedUser() && resource.data.uploadedByUid == request.auth.uid);
      allow create: if isValidId(syllabusId) && isVerifiedUser() && isValidSyllabus(incoming()) && (
        hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ACADEMIC_MANAGER']) ||
        (
          isLecturer() &&
          incoming().publishedStatus == 'unpublished' &&
          incoming().approvalStatus in ['Draft', 'Pending Review'] &&
          incoming().uploadedByUid == request.auth.uid
        )
      );
      allow update: if isValidId(syllabusId) && isVerifiedUser() && isValidSyllabus(incoming()) &&
        incoming().courseId == existing().courseId && (
        hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ACADEMIC_MANAGER']) ||
        (
          isLecturer() &&
          existing().publishedStatus != 'published' &&
          incoming().publishedStatus == 'unpublished' &&
          incoming().approvalStatus in ['Draft', 'Pending Review'] &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'approvalStatus', 'latestVersionNumber', 'latestVersionId', 'moduleCount', 'topicCount',
            'hasFileAttachment', 'latestFileName', 'latestFileUrl', 'latestFileMimeType',
            'totalCourseDuration', 'announcementNote', 'updatedAt'
          ])
        )
      );
      allow delete: if isValidId(syllabusId) && isSuperAdminOwner();
    }

    match /syllabusVersions/{versionId} {
      allow get: if isValidId(versionId) && isVerifiedUser() && (
        resource.data.status == 'Published' || isAdminStaff() || isLecturer()
      );
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.status == 'Published') || (isVerifiedUser() && resource.data.createdByUid == request.auth.uid);
      allow create: if isValidId(versionId) && isVerifiedUser() && isValidSyllabusVersion(incoming()) && (
        hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ACADEMIC_MANAGER']) ||
        (
          isLecturer() &&
          incoming().status in ['Draft', 'Pending Review'] &&
          incoming().createdByUid == request.auth.uid
        )
      );
      allow update: if isValidId(versionId) && isVerifiedUser() && isValidSyllabusVersion(incoming()) &&
        incoming().syllabusId == existing().syllabusId &&
        incoming().versionNumber == existing().versionNumber &&
        incoming().createdAt == existing().createdAt && (
        hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ACADEMIC_MANAGER']) ||
        (
          isLecturer() &&
          existing().status in ['Draft', 'Pending Review'] &&
          incoming().status in ['Draft', 'Pending Review'] &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'changeSummary', 'totalCourseDuration', 'finalAssessment',
            'announcementNote', 'attachment', 'supportingResources', 'modules', 'updatedAt'
          ])
        )
      );
      allow delete: if false;
    }

    match /moduleProgress/{progressId} {
      allow get: if isValidId(progressId) && isVerifiedUser() && (
        resource.data.userId == request.auth.uid || isAdminStaff() || isLecturer()
      );
      allow list: if isSuperAdminOwner() || (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(progressId) && isVerifiedUser() &&
        isValidModuleProgress(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isValidId(progressId) && isVerifiedUser() &&
        isValidModuleProgress(incoming()) &&
        incoming().userId == existing().userId &&
        existing().userId == request.auth.uid &&
        incoming().courseId == existing().courseId &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'syllabusId', 'versionNumber', 'completedModuleIds', 'completedTopicIds',
          'completedActivityIds', 'completedAssignmentIds', 'totalTrackableItems',
          'completedTrackableItems', 'progressPercent', 'updatedAt'
        ]);
      allow delete: if isValidId(progressId) && isSuperAdminOwner();
    }
  }
}
