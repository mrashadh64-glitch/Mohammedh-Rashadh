# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Official production website domain or Cloud Run service URL.
APP_URL="https://techmancollege.online"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform browser key (Maps JS, Places API New, Routes API).
# Restrict by HTTP referrers and required APIs in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# OPENAI_API_KEY: Optional server-side OpenAI / ChatGPT API key for AI Poster Copy, Course Descriptions, Translations & Captions.
# Configure securely on the server / Settings > Secrets. Never expose in client code.
OPENAI_API_KEY=

# APIFY_API_TOKEN: Optional server-side Apify API token for approved public education/market research actors.
# Configure securely on the server / Settings > Secrets. Never expose in client code.
APIFY_API_TOKEN=

# EMAIL DELIVERY (Optional: configure either Resend OR SMTP in server secrets)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="TECHMAN COLLEGE ONLINE <noreply@techmancollege.online>"

# POSTER_RECEIPT_SECRET: Recommended 32+ char random secret in production so poster approval receipts persist across restarts.
POSTER_RECEIPT_SECRET=

# PORT: Server listen port (Cloud Run injects 8080 automatically; defaults to 3000 locally).
PORT=3000
